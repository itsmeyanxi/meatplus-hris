# Root-level dev environment defaults.
# Per-app environment (backend/.env, frontend/.env.local) is generated after scaffolding.

# Postgres (matches compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meatplus_hris
POSTGRES_USER=meatplus
POSTGRES_PASSWORD=meatplus_dev_only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible local)
S3_ENDPOINT=http://localhost:9000
S3_KEY=meatplus
S3_SECRET=meatplus_dev_only
S3_BUCKET=meatplus-hris-dev
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Mailpit (catches outbound dev emails)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@meatplus.local
MAIL_FROM_NAME="Meatplus HRIS (dev)"
