# Meatplus HRIS — reverse proxy (HTTP-FIRST, port 80 only).
#
# The leading "http://" forces plain HTTP on port 80 — Caddy will NOT try to
# fetch a TLS certificate or use 443. This is the staged "go live over HTTP now,
# add HTTPS later" setup, since port 80 is already forwarded but 443 is not.
#
# TO UPGRADE TO HTTPS LATER: forward 443 on the router, then change the site
# address below from "http://allcompanyhris.meatplus.ph" to just
# "allcompanyhris.meatplus.ph" and re-add the Strict-Transport-Security header.
# Caddy will then auto-fetch a Let's Encrypt certificate. Also flip
# SESSION_SECURE_COOKIE back to true and APP_URL back to https in .env.production.
#
# The frontend (3001) proxies /api, /sanctum, /up to the backend (8000). The
# ZKTeco /iclock routes are NOT proxied here, so they stay LAN-only.
#
# Run:  tools\caddy.exe run --config Caddyfile   (start-production.ps1 does this)

http://allcompanyhris.meatplus.ph {
	encode gzip
	reverse_proxy 127.0.0.1:3001

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
